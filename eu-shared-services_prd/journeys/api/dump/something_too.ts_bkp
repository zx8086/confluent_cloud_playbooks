import { journey, step, monitor, expect } from '@elastic/synthetics';

journey('Storytelling API Journey', async ({ context }: { context: any }) => {
  monitor.use({
    id: 'Storytelling',
    schedule: 30,
    screenshot: 'off',
  });

  const baseUrl = 'https://storytelling.dev.shared-services.eu.pvh.cloud/v3';

  // Reusable function to fetch data from the API
  async function fetchApiData(url: string) {
    return await context.request.get(url);
  }

  // Reusable function to verify response status code
  function verifyResponse(response, expectedStatusCode) {
    expect(response.status()).toBe(expectedStatusCode);
  }

  // Reusable function to verify response structure
  function verifyResponseStructure(responseBody) {
    expect(responseBody).toHaveProperty('data');
    expect(Array.isArray(responseBody.data)).toBe(true);
    expect(responseBody).toHaveProperty('totalLookItems');
    expect(typeof responseBody.totalLookItems).toBe('number');
    expect(responseBody).toHaveProperty('skip');
    expect(typeof responseBody.skip).toBe('number');
    expect(responseBody).toHaveProperty('top');
    expect(typeof responseBody.top).toBe('number');
    expect(responseBody).toHaveProperty('hasNextPage');
    expect(typeof responseBody.hasNextPage).toBe('boolean');
  }

  // Step 1: Get Looks for Support by NuxeoId
  step('GET - Looks for Support by NuxeoId', async () => {
    const nuxeoId = 'your-nuxeo-id'; // Replace with actual NuxeoId
    const response = await fetchApiData(`${baseUrl}/support/looks/look/${nuxeoId}`);
    const responseBody = await response.json();
    console.log(JSON.stringify(responseBody));

    verifyResponse(response, 200);
    verifyResponseStructure(responseBody);
    // Additional validations specific to this endpoint
    // ...
  });

  // Step 2: Get Looks by Brand and Season
  step('GET - Looks by Brand and Season', async () => {
    const brandCode = 'your-brand-code'; // Replace with actual Brand Code
    const styleSeasonCode = 'your-season-code'; // Replace with actual Season Code
    const response = await fetchApiData(`${baseUrl}/looks/brand/${brandCode}/season/${styleSeasonCode}`);
    const responseBody = await response.json();
    console.log(JSON.stringify(responseBody));

    verifyResponse(response, 200);
    verifyResponseStructure(responseBody);
    // Additional validations specific to this endpoint
    // ...
  });

  // Step 3: Get Looks by Brand, Division, and Season
  step('GET - Looks by Brand, Division, and Season', async () => {
    const brandCode = 'your-brand-code'; // Replace with actual Brand Code
    const divisionCode = 'your-division-code'; // Replace with actual Division Code
    const styleSeasonCode = 'your-season-code'; // Replace with actual Season Code
    const response = await fetchApiData(`${baseUrl}/looks/brand/${brandCode}/division/${divisionCode}/season/${styleSeasonCode}`);
    const responseBody = await response.json();
    console.log(JSON.stringify(responseBody));

    verifyResponse(response, 200);
    verifyResponseStructure(responseBody);
    // Additional validations specific to this endpoint
    // ...
  });

  // Step 4: Get Looks by Brand, Division, Season, and AssetType
  step('GET - Looks by Brand, Division, Season, and AssetType', async () => {
    const brandCode = 'your-brand-code'; // Replace with actual Brand Code
    const divisionCode = 'your-division-code'; // Replace with actual Division Code
    const styleSeasonCode = 'your-season-code'; // Replace with actual Season Code
    const assetType = 'your-asset-type'; // Replace with actual Asset Type
    const response = await fetchApiData(`${baseUrl}/looks/brand/${brandCode}/division/${divisionCode}/season/${styleSeasonCode}/assetType/${assetType}`);
    const responseBody = await response.json();
    console.log(JSON.stringify(responseBody));

    verifyResponse(response, 200);
    verifyResponseStructure(responseBody);
    // Additional validations specific to this endpoint
    // ...
  });
});
